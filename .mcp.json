{
  "mcpServers": {
    "eduhub-db": {
      "command": "uvx",
      "args": [
        "--python", "3.12",
        "--overrides", ".mcp/postgres-mcp-overrides.txt",
        "postgres-mcp@0.3.0",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${EDUHUB_DB_READONLY_URL}"
      }
    }
  }
}
