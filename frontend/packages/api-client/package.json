{
  "name": "@eduhub/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "백엔드 OpenAPI 스펙에서 생성한 Axios 클라이언트. src/는 생성 코드이므로 직접 고치지 않는다.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-axios -o src --additional-properties=supportsES6=true"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3"
  }
}
