# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 백엔드(bootRun, test)가 이 파일을 자동으로 읽는다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 기본값과 다를 때만 주석을 풀어 쓴다. (빈 값으로 두면 기본값 대신 빈 값이 들어간다)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_TEST_DB=eduhub_test

# Claude Code DB MCP(.mcp.json의 eduhub-db)가 쓰는 개발 DB 읽기 전용 계정 접속 주소.
# .mcp.json은 .env를 읽지 않는다. 사용자 환경 변수로 설정하고 Claude Code를 다시 시작한다.
# 형식: postgresql://<읽기 전용 계정>:<비밀번호>@<호스트>:<포트>/<DB 이름>
EDUHUB_DB_READONLY_URL=
EDUHUB_JWT_SECRET=
